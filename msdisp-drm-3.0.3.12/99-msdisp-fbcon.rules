# Map the text consoles (VT1..6) to the MS912x USB panel's framebuffer whenever
# it appears, so the Linux TTY console shows on the panel automatically (incl.
# after a replug). Requires con2fbmap (Debian/Ubuntu: package "fbset").
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", ACTION=="add", ATTR{name}=="msdispdrmfb", \
    RUN+="/bin/sh -c 'for v in 1 2 3 4 5 6; do /usr/bin/con2fbmap $v %n; done'"
